{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The only permissions Mori's UI has: listen for its own events, drag the window, and call Mori's own narrow commands. No filesystem, shell, HTTP, opener or dialog plugin APIs are exposed.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-init",
    "allow-update-settings",
    "allow-choose-root",
    "allow-rescan",
    "allow-clear-cache",
    "allow-get-status",
    "allow-query",
    "allow-stats",
    "allow-subfolders",
    "allow-inspect",
    "allow-preview-info",
    "allow-read-text",
    "allow-open-file",
    "allow-reveal-file",
    "allow-copy-path",
    "allow-store-frame",
    "allow-video-session-start",
    "allow-ui-alive",
    "allow-video-session-end",
    "allow-take-recovered",
    "allow-trash-summary",
    "allow-trash-items",
    "allow-rename-item",
    "allow-analysis-locations",
    "allow-analysis-choose-folder",
    "allow-analysis-start",
    "allow-analysis-cancel",
    "allow-analysis-results",
    "allow-analysis-clear",
    "allow-analysis-cleanup",
    "allow-analysis-cleanup-cancel",
    "allow-similar-start",
    "allow-similar-cancel",
    "allow-similar-frames",
    "allow-similar-results",
    "allow-similar-dismiss",
    "allow-similar-dismissed-count",
    "allow-similar-forget-decisions",
    "allow-similar-clear",
    "allow-similar-cleanup",
    "allow-set-folder-private",
    "allow-file-report",
    "allow-set-read-only",
    "allow-set-folder-protected",
    "allow-pdf-info",
    "allow-archive-listing",
    "allow-open-drive-safely",
    "allow-set-drive-previews",
    "allow-set-capture-override",
    "allow-storage-report",
    "allow-set-favorite",
    "allow-plan-operation",
    "allow-delete-items",
    "allow-history-list",
    "allow-history-undo",
    "allow-tags-list",
    "allow-tag-items",
    "allow-tag-rename",
    "allow-tag-delete",
    "allow-open-temporary",
    "allow-end-temporary",
    "allow-forget-drive",
    "allow-clear-session-data",
    "allow-empty-folders",
    "allow-trash-empty-folders",
    "allow-health-start",
    "allow-health-pause",
    "allow-health-cancel",
    "allow-health-clear",
    "allow-health-results",
    "allow-file-metadata",
    "allow-meta-start",
    "allow-meta-pause",
    "allow-meta-cancel",
    "allow-meta-clear",
    "allow-meta-results",
    "allow-meta-places",
    "allow-sanitize-copies"
  ]
}
